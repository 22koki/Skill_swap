# Local development uses SQLite and localhost without additional configuration.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production: set DJANGO_DEBUG=False, replace the secret, provide the domains,
# PostgreSQL DATABASE_URL and REDIS_URL. HTTPS should terminate at the proxy.
DATABASE_URL=
DJANGO_DB_SSLMODE=prefer
DJANGO_TRUST_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=True

# Optional AI enhancement; fallback planner works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Required for multi-instance production realtime messaging.
REDIS_URL=
