DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True

# Optional: enables true AI-generated SkillSwap learning plans.
# Without this, the app uses the built-in structured fallback planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna


# Optional in local development. Required/recommended for multi-process production realtime.
# Example: redis://127.0.0.1:6379/0
REDIS_URL=
